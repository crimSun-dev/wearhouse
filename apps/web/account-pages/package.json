{
  "name": "@wearhouse/account-pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TEMPORARY account pages for Wearhouse v2 (Neon Auth + Google). Replaced by the frontend rebuild.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build.mjs",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@neon/auth": "0.8.2",
    "@wearhouse/contracts": "file:../../../packages/contracts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.3",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
