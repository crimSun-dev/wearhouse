# Wearhouse v2 configuration EXAMPLE. The API never reads this file: export these variables in the
# shell, container or host secret store. Never commit real values. (Legacy v1 uses legacy/python/.env.)

# development | test | staging | production   (staging/production = deployment: fail-closed checks)
WEARHOUSE_ENV=development
# Runtime role (least privilege; SELECT/INSERT/UPDATE per apps/api/src/wearhouse/bootstrap/schema.py)
WEARHOUSE_DATABASE_URL=postgresql://wearhouse_runtime:CHANGE_ME@127.0.0.1:5432/wearhouse_dev
# Migration role, used only by `wearhouse migrate` (release command). Owns the v2 database.
WEARHOUSE_MIGRATION_DATABASE_URL=postgresql://wearhouse_migrator:CHANGE_ME@127.0.0.1:5432/wearhouse_dev
# Identity broker: Neon Auth (Managed Better Auth, Google sign-in). From the branch's NEON_AUTH_BASE_URL,
# e.g. https://ep-xxxx.aws.neon.tech/neondb/auth :
#   issuer and audience = the ORIGIN only (https://ep-xxxx.aws.neon.tech)
#   JWKS URL            = NEON_AUTH_BASE_URL + /.well-known/jwks.json   (Neon Auth publishes no discovery)
WEARHOUSE_OIDC_ISSUER=https://ep-xxxx.aws.neon.tech
WEARHOUSE_OIDC_AUDIENCE=https://ep-xxxx.aws.neon.tech
WEARHOUSE_OIDC_JWKS_URL=https://ep-xxxx.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Neon Auth signs EdDSA only; this may narrow (never widen) the allowlist EdDSA,RS256
WEARHOUSE_OIDC_ALGORITHMS=EdDSA
# Only for a provider that does publish /.well-known/openid-configuration and no JWKS URL is set:
# WEARHOUSE_OIDC_DISCOVERY=on
# Development only: a local issuer's JWKS file (tools/dev_issuer.py). Rejected in staging/production.
# WEARHOUSE_OIDC_JWKS_FILE=apps/api/.local/dev-issuer-jwks.json
# Issuance-delivery secret: url-safe base64 of >= 32 random bytes (`wearhouse generate-secret`)
WEARHOUSE_DELIVERY_SECRET=
# Previous secret during rotation (decrypt/verify only, keep for >= 24 h)
# WEARHOUSE_DELIVERY_SECRET_PREVIOUS=
# Browser origins allowed to call the API (https only in deployment)
# The temporary account pages (apps/web/account-pages) run on 5174
WEARHOUSE_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
# Reverse proxies whose X-Forwarded-For may be trusted for per-IP limits (empty = trust none)
WEARHOUSE_TRUSTED_PROXIES=
# Redemption admission budgets per rolling hour (per-user is fixed at 10). "off" disables a budget.
WEARHOUSE_REDEMPTION_IP_LIMIT=60
WEARHOUSE_REDEMPTION_GLOBAL_LIMIT=5000
