# Copy to backend/.env (git-ignored). Never commit real credentials.
# Neon: paste the connection string from the Neon console (postgresql://...?sslmode=require).
# Leave unset to use the offline SQLite file backend/demo.db.
DATABASE_URL=
# mock = frozen real BMKG sample (offline), live = api.bmkg.go.id
WEATHER_MODE=mock
# Static key guarding every write (X-API-Key header). Change it for a public deployment.
DEMO_API_KEY=demo-key
DEFAULT_ADM4=31.71.03.1001
BMKG_TIMEOUT_S=3.0
AUTO_SEED=1
# Comma-separated origins allowed to call the API from another site (e.g. a hosted test page)
CORS_ORIGINS=
